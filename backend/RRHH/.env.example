# =======================================
# BASE DE DATOS - Supabase o PostgreSQL local
# =======================================
DB_URL=jdbc:postgresql://localhost:5432/sangabriel_db_rrhh
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE

# =======================================
# JWT (Generar con: openssl rand -base64 32)
# =======================================
JWT_SECRET=YOUR_JWT_SECRET_HERE

# =======================================
# EMAIL - Gmail con contraseña de aplicación
# =======================================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE

# =======================================
# FRONTEND URL (Vercel o localhost)
# =======================================
FRONTEND_URL=http://localhost:5173

# =======================================
# CORS - Orígenes permitidos
# =======================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# =======================================
# ALMACENAMIENTO DE EVIDENCIAS
# =======================================
UPLOAD_DIR=uploads/evidencias

# =======================================
# JPA / HIBERNATE
# =======================================
JPA_SHOW_SQL=true
TX_TIMEOUT=30
MVC_TIMEOUT=30000
